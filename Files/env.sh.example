# env.sh — copy this file to ./env.sh at the repo root, edit for your
# environment, do NOT commit it.
#   cp Files/env.sh.example env.sh
# Every script sources it via Scripts/lib/common.sh.

# ── Platform ──────────────────────────────────────────────────────────────────
# rancher-desktop | k3s | k3d | kind | minikube | generic
PLATFORM="rancher-desktop"
KUBECTL="kubectl"
KUBE_CONTEXT="rancher-desktop"        # empty = use kubectl's current-context

# ── Image build / delivery ───────────────────────────────────────────────────
# How locally-built images reach the kubelet.
#   rancher-desktop (containerd) : nerdctl, images loaded into ctr namespace k8s.io
#   rancher-desktop (dockerd)    : docker, image is visible to the kubelet directly
#   kind                         : docker + `kind load docker-image`
#   minikube                     : docker/podman + `minikube image load`
#   generic (remote cluster)     : set REGISTRY and the scripts push instead of load
CONTAINER_TOOL="nerdctl"
CONTAINERD_NAMESPACE="k8s.io"         # rancher-desktop / k3s only
REGISTRY=""                           # e.g. ghcr.io/cloudxabide ; empty = local load only
IMAGE_PULL_POLICY="IfNotPresent"

# ── NeuVector (SUSE Security) ────────────────────────────────────────────────
NEUVECTOR_NAMESPACE="neuvector"
NEUVECTOR_HELM_REPO="https://neuvector.github.io/neuvector-helm/"
# PIN an explicit chart version for reproducibility. Check available versions:
#   helm repo add neuvector "$NEUVECTOR_HELM_REPO" && helm repo update
#   helm search repo neuvector/core --versions
NEUVECTOR_CHART_VERSION=""            # e.g. 2.8.6  (latest 5.4.x app line)
NEUVECTOR_CRI_RUNTIME="k3s"           # k3s | containerd | docker | crio
NEUVECTOR_CONTAINERD_SOCK="/run/k3s/containerd/containerd.sock"   # RD/k3s path
NEUVECTOR_CONSOLE_EXPOSE="port-forward"   # port-forward | nodeport | loadbalancer
NEUVECTOR_CONSOLE_PORT="8443"
NEUVECTOR_ADMIN_PASSWORD="admin"      # demo only — NeuVector default is admin/admin

# ── Demo workloads ──────────────────────────────────────────────────────────
NS_SCI="aperture-sci"                 # fat-image demo   (chell-test / "weighted companion pod")
NS_LABS="aperture-labs"               # distroless demo  (wheatley)

CLEAN_APP_IMAGE="nicolaka/netshoot:latest"
DISTROLESS_APP_IMAGE="${REGISTRY:+$REGISTRY/}wheatley-server:latest"
DEBUG_IMAGE="busybox:1.36"            # ephemeral-container foothold (Chamber 05)

# ── Test parameters ────────────────────────────────────────────────────────
BASELINE_TARGET_URL="https://www.fastly.com"
BASELINE_INTERVAL_SECONDS="5"
EICAR_URL="https://secure.eicar.org/eicar.com.txt"   # harmless industry-standard AV test file

# ── Optional ───────────────────────────────────────────────────────────────
DEMO_HOSTNAME=""                      # only if exposing the console via ingress; usually unused
